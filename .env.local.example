# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase — Project Settings → API
# New-format keys (sb_publishable_/sb_secret_), not the legacy anon/service_role JWTs.
# SUPABASE_SECRET_KEY is server-only (bypasses RLS) — never expose it to the client.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY does reach the browser bundle (used only for
# Supabase Auth calls — see app/lib/supabase/browser.ts) but every table's RLS is
# deny-all with zero policies (supabase/migrations/0001_init.sql), so it can't read
# or write a single row via PostgREST regardless.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Run supabase/migrations/0001_init.sql against the new project before first
# use — it creates the schema plus the handle_new_auth_user() trigger that
# mirrors every Supabase Auth sign-up into public.users/public.preferences.
#
# In the Supabase dashboard, Authentication → Providers → Email: leave
# "Confirm email" on for a real deployment (sends a real confirmation
# email), or turn it off for local/demo use if you want signUp() to return
# an active session immediately with no email step.

# Phase 3 — briefing generation pipeline (app/lib/briefing/).

# Google AI Studio (aistudio.google.com) → "Get API key" → Create API key.
# Free tier, no card required. Used once per user per day to condense
# fetched news headlines into the News section (app/lib/briefing/sources/news.ts),
# and to parse typed commands (app/lib/commands/parse.ts). Free-tier rate
# limits are low (a handful of requests/minute) — fine for this project's
# scale, but check ai.google.dev if this starts failing under real traffic.
# If left blank, news generation still works (RSS headlines still fetch),
# it just skips condensing and the News section stays "unavailable" — same
# graceful-degradation behavior as the other optional keys below.
GEMINI_API_KEY=

# Finnhub (finnhub.io) → free account → Dashboard shows your API key
# immediately, no card required. Used for stock/ETF quotes (market summary
# section). Crypto (BTC-USD) uses CoinGecko instead, which needs no key.
FINNHUB_API_KEY=

# Optional but a primary news source, not just a depth add-on. The Guardian
# Open Platform (open-platform.theguardian.com) → free "Developer" key,
# delivered by email. The News section targets 3 Guardian stories + 2 from
# NYT (below) per generation, since Guardian's own dek/trailText is
# real editorial context (unlike the keyless Google News RSS feed's
# description field, which is just the headline re-wrapped with no real
# content) — that's what makes a genuinely longer, grounded summary
# possible. If this is left blank, news generation still works, just from
# NYT/RSS alone.
GUARDIAN_API_KEY=

# Optional but a primary news source alongside Guardian (see above) — Article
# Search API. Free registration at developer.nytimes.com/get-started, app
# dashboard shows your API key immediately (the app secret it also shows
# isn't needed — NYT's public REST APIs auth on the key alone). The
# pipeline degrades to Google News RSS if this errors or the quota's
# exhausted, same as every other optional key here.
NYT_API_KEY=

# Phase 4 — scheduling + delivery (app/api/briefing/cron, app/lib/briefing/due.ts, app/lib/briefing/email.ts).
# Also gates Phase 6's daily purge route (app/api/briefing/purge) — same
# secret, same two GitHub Actions workflows (briefing-cron.yml every 15
# min, briefing-purge.yml once a day), no separate setup needed for it.

# Shared secret the GitHub Actions cron workflow sends as a Bearer token so
# /api/briefing/cron can't be triggered by anyone who finds the URL — that
# route generates + emails for every due user, so this is real cost control,
# not just tidiness. Generate with:
#   openssl rand -base64 32
# Set the same value here AND as a GitHub Actions repository *secret* named
# CRON_SECRET (repo → Settings → Secrets and variables → Actions → Secrets
# tab → New repository secret). Also add a repository *variable* (same
# page, Variables tab) named APP_URL set to this app's real deployed URL
# (e.g. https://your-site.netlify.app, no trailing slash) — the workflow
# needs both to know where to call and what secret to send.
CRON_SECRET=

# Set to "false" to disable client-side post-render refreshes for Weather
# and Markets. The stored Today dashboard still renders normally.
NEXT_PUBLIC_BACKGROUND_SECTION_REFRESH=true

# Optional. Sentry error tracking is disabled by default in this fork (it
# doesn't share the private app's Sentry project) — set this to your own
# Sentry project's DSN to turn it back on. Leave blank to keep it off.
NEXT_PUBLIC_SENTRY_DSN=
